[gd_resource type="Theme" load_steps=2 format=3]

; 全域 Theme：default_font 會套到所有未單獨指定字型的 Control，
; 並作為 ThemeDB.fallback_font（draw_string 等）的來源。
; 字型檔請放在 res://assets/font/，若要換字體改下方 ext_resource path 即可。

[ext_resource type="FontFile" path="res://assets/font/jf-openhuninn-2.1.ttf" id="1_main_font"]

[resource]
default_font = ExtResource("1_main_font")
default_font_size = 16
