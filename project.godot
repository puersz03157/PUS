; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="命運的彈珠倖存者"
config/description="升級時透過彈珠台選擇武器/能力的倖存者遊戲，支援單機雙人。"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

RegisterGamepadInputs="*res://scripts/register_gamepad_inputs.gd"
GameData="*res://scripts/game_data.gd"
GameState="*res://scripts/game_state.gd"
AudioManager="*res://scripts/audio_manager.gd"
TranslationLoader="*res://scripts/translation_loader.gd"
SettingsOverlay="*res://scripts/settings_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/YATI/plugin.cfg")

[gui]

theme/custom="res://theme/default.tres"
theme/custom_font="uid://5nq71l5mf07b"

